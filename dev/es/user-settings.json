{
  "settings": {
    "index": {
      "analysis": {
        "normalizer": {
          "lowercase_normalizer": {
            "filter": ["lowercase", "asciifolding"],
            "type": "custom"
          }
        },
        "analyzer": {
          "custom_fullname_analyzer": {
            "filter": ["lowercase", "asciifolding"],
            "type": "custom",
            "tokenizer": "standard"
          },
          "custom_email_analyzer": {
            "filter": ["lowercase"],
            "type": "custom",
            "tokenizer": "uax_url_email"
          }
        }
      }
    }
  }
}
